  </div>
  <div class="hero-image">
    <div class="image-placeholder">
      <span>HANA MI</span>
      <p>Vietnamese Learning Studio</p>
    </div>
  </div>
</section>

<section class="intro">
  <p class="eyebrow">WHY HANA MI?</p>
