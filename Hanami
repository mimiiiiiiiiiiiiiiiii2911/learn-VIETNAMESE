  <div class="cards">
    <article class="card">
      <h3>60 minutes</h3>
      <h2>$10</h2>
      <p>One personalized Vietnamese lesson.</p>
    </article>
    <article class="card">
      <h3>90 minutes</h3>
      <h2>$15</h2>
      <p>More time for conversation and practice.</p>
    </article>
    <article class="card featured">
      <h3>Learning Package</h3>
      <h2>$54</h2>
      <p>6 lessons over 3 weeks.</p>
    </article>
  </div>

  <a class="primary-btn" href="mailto:thaomy29112007@gmail.com?subject=Vietnamese%20Lesson%20Booking">
    Book a lesson
  </a>
</section>

<section class="about" id="about">
  <p class="eyebrow">MEET YOUR TEACHER</p>
  <h2>Xin chào, I'm Hana Mi!</h2>
  <p>
    I'm a Vietnamese tutor who loves languages,
    cultural exchange and helping international learners
    discover the Vietnamese language.
  </p>
  <p>Let's make learning Vietnamese a lovely experience.</p>
</section>

</main>

<footer>
  <a class="logo" href="#">Hana Mi<span>.</span></a>
  <p>Learn Vietnamese with confidence ♡</p>
  <p>© 2026 Hana Mi. All rights reserved.</p>
</footer>

<!-- Authentication modal -->
<div id="auth-modal" class="modal">
  <div class="modal-box">
    <button class="close" onclick="hideAuth()">×</button>
    <h2>Welcome to Hana Mi</h2>
    <p>Create your learning account.</p>

    <form id="auth-form">
      <input type="email" id="email" placeholder="Email address" required>
      <input type="password" id="password" placeholder="Password (at least 6 characters)" minlength="6" required>
      <button type="submit" class="primary-btn">Log in</button>
    </form>

    <button class="text-btn" onclick="toggleAuth()">
      Don't have an account? Sign up
    </button>
    <p id="auth-message"></p>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="config.js"></script>
<script src="app.js"></script>
